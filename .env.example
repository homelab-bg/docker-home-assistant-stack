# Monitoring Stack Integration
MONITORING_STACK=your-monitoring-stack-name

# Network Configuration
NETWORK=traefik

# General
#TZ=Australia/Brisbane

# Image versions (defaults shown)
#HA_VER=2026.9.2
#ESPHOME_VER=latest
#MATTER_VER=stable
#EPC_VER=latest
#MOSQUITTO_VER=latest
#CLOUDFLARED_VER=latest

# Matter Server - host NIC for link-local IPv6/mDNS (e.g. eth0 on a VM; check
# `ip -br addr`). Optional, but must exist on the host if set.
#MATTER_INTERFACE=eth0

# Everything Presence Configurator
HA_BASE_URL=https://ha.example.com
# Long-lived token from HA (Profile > Security) goes in
# secrets/ha_long_lived_token (gitignored), NOT here.

# Traefik Configuration (required by docker-compose.traefik.yml)
HA_HOST=ha.example.com
ESPHOME_HOST=esphome.example.com
EPC_HOST=ep-configurator.example.com

# cloudflared (docker-compose.cloudflared.yml) - token goes in
# secrets/cloudflare_tunnel_token (gitignored), NOT here.
